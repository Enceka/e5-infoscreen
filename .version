# e5-infoscreen 的发布：改这个文件并 push，release workflow 就按下面的字段发布。
# (.github/workflows/release.yml -> tools/make-release.sh)
#   version    版本号，点分，须比设备上已有的新
#   notes_zh   发布说明（中文）
#   notes_en   release notes (English)；留空则用中文
version=1.6.1
notes_zh=新增信息屏项目主页和 Pages 更新源；页面与设备共用 latest.json，保留 GitHub Release 更新兼容旧设备。
notes_en=Add the info screen project page and a Pages update feed; the page and devices share latest.json while GitHub Releases remains available for older devices.
