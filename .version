# e5-infoscreen 的发布：改这个文件并 push，release workflow 就按下面的字段发布。
# (.github/workflows/release.yml -> tools/make-release.sh)
#   version    版本号，点分，须比设备上已有的新
#   notes_zh   发布说明（中文）
#   notes_en   release notes (English)；留空则用中文
version=1.5.0
notes_zh=增加通用应用通知 API：提交、撤销、后台只读通知、统一弹窗及亮屏；插件 API 2 向后兼容 API 1。
notes_en=Add generic application notifications: submit, clear, read-only background providers, shared alerts and wake control; plugin API 2 remains compatible with API 1.
