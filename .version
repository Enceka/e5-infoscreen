# e5-infoscreen 的发布：改这个文件并 push，release workflow 就按下面的字段发布。
# (.github/workflows/release.yml -> tools/make-release.sh)
#   version    版本号，点分，须比设备上已有的新
#   notes_zh   发布说明（中文）
#   notes_en   release notes (English)；留空则用中文
version=1.6.2
notes_zh=LuCI 新增信息屏设置和主程序更新包上传；插件页、屏幕更新和设置入口保持一致。
notes_en=Add LuCI settings and main-program package upload; keep the plugin page, screen updater and configuration entry points aligned.
