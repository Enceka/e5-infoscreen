#!/bin/sh
# Traffic accounting for the info screen's traffic page: vnstat counts the
# modem's data interface (sipa_eth0), day by day and month by month.  Its
# database goes to /etc/vnstat -- the package's /var/lib/vnstat is RAM on
# OpenWrt, and a month's total must survive a reboot.
[ -f /etc/vnstat.conf ] || exit 0
mkdir -p /etc/vnstat
sed -i 's|^;*DatabaseDir .*|DatabaseDir "/etc/vnstat"|' /etc/vnstat.conf
# written every minute, not every 5: the page's today and month are the database's
sed -i 's|^;*SaveInterval .*|SaveInterval 1|' /etc/vnstat.conf
uci -q get vnstat.@vnstat[0] >/dev/null || uci -q add vnstat vnstat >/dev/null
uci -q del_list vnstat.@vnstat[0].interface=sipa_eth0
uci add_list vnstat.@vnstat[0].interface=sipa_eth0
uci commit vnstat
/etc/init.d/vnstat enable
/etc/init.d/vnstat restart >/dev/null 2>&1
exit 0
