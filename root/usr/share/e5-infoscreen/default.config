config infoscreen 'main'
	# 0 turns the screen service off (the panel stays dark)
	option enabled '1'
	# seconds without a touch or a key before the backlight goes off; 0 = never
	option idle '60'
	# backlight level while the screen is on, 1-255
	option brightness '120'
	# 0: the panel ignores touch, the keys only
	option touch '1'
	# zh or en
	option lang 'zh'
