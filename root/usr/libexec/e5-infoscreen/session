#!/bin/sh
# cage + cog on the panel, run by /etc/init.d/e5-infoscreen (instance "ui").
export XDG_RUNTIME_DIR=/tmp/run/e5-infoscreen
mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"
export LIBSEAT_BACKEND=seatd
export XKB_DEFAULT_LAYOUT=us
# the page formats times itself: WebKit needs the device's time zone (OpenWrt
# keeps it in /etc/TZ, a POSIX TZ string, written from uci system.timezone)
TZ=$(cat /etc/TZ 2>/dev/null)
export TZ=${TZ:-UTC0}
export HOME=/tmp/run/e5-infoscreen

# seatd and the api instance start next to this one: wait for both (whole
# seconds -- OpenWrt's busybox sleep takes no fractions)
i=0
while [ ! -S /run/seatd.sock ] && [ $i -lt 10 ]; do sleep 1; i=$((i + 1)); done
i=0
# (8088 = 0x1F98, listening = state 0A)
while ! grep -q ':1F98 00000000:0000 0A' /proc/net/tcp && [ $i -lt 10 ]; do sleep 1; i=$((i + 1)); done

# cog and its WebKit processes outlive cage when cage is stopped -- and then
# spin, with no compositor to talk to -- so this script stays the procd
# instance and takes them down with it, whichever of the two ends first.
CLIENTS="cog WPEWebProcess WPENetworkProcess"
stop_clients() {
	killall -q $CLIENTS 2>/dev/null
	sleep 1
	killall -q -9 $CLIENTS 2>/dev/null
}
on_term() {
	[ -n "$CAGE" ] && kill -TERM "$CAGE" 2>/dev/null
	stop_clients
	exit 0
}
trap on_term TERM INT
# leftovers of an earlier session (killed without this script's cleanup)
stop_clients
# WebKit's HTTP cache, which outlives the session in /tmp/run: uhttpd sends no
# Cache-Control, so WebKit would keep an updated page's old index.html and
# app.js on its own heuristic, until the next boot
rm -rf "$HOME/.cache/wpe/WebKitCache"

# -d: no client-side decorations.  cog: the page, black behind it, the page's
# console into the log (logread -e e5-infoscreen), a new web process if one dies
/usr/bin/cage -d -- /usr/bin/cog -P wl --bg-color=black \
	--enable-write-console-messages-to-stdout=true \
	--webprocess-failure=restart \
	http://127.0.0.1:8088/ &
CAGE=$!
wait "$CAGE"
rc=$?
stop_clients
exit $rc
